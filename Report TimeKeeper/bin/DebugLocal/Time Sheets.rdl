  <DataSources>
    <DataSource Name="TimeKeeperDataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=(localdb)\mssqllocaldb;Initial Catalog=aspnet-TimeKeeperApp-70da1db0-8bee-4650-800b-a3284b1fbf5b;MultipleActiveResultSets=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>8beb6bac-35c7-4e62-a1c9-30bd9779ac04</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="TimeKeeperDataSet">
      <Query>
        <DataSourceName>TimeKeeperDataSource</DataSourceName>
        <CommandText>SELECT te.Week AS [Week Starting], asu.UserName AS [Submitted By], te.TimeIn AS [Time In], te.TimeOut AS [Time Out], te.HoursWorked AS [Hours Worked]
FROM   TimeEntry AS te INNER JOIN
         AspNetUsers AS asu ON te.UserID = asu.Id
GROUP BY asu.UserName, te.Week, te.TimeIn, te.TimeOut, te.HoursWorked</CommandText>
      </Query>
      <Fields>
        <Field Name="Submitted_By">
          <DataField>Submitted By</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Week_Starting">
          <DataField>Week Starting</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Time_In">
          <DataField>Time In</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Time_Out">
          <DataField>Time Out</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Hours_Worked">
          <DataField>Hours Worked</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
