@page
@model TimeKeeperApp.Pages.TimeEntryPages.IndexModel
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Rendering
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole(Constants.InternRole) ||
    User.IsInRole(Constants.AdminRole))
{
    <p>
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    </p>
}

@{
    var weekSelectList = Model.Weeks.Select(w => new SelectListItem
    {
        Value = w.ToString("yyyy-MM-dd"),
        Text = w.ToString("yyyy-MM-dd")
    }).ToList();

    var userSelectList = Model.Users; // already SelectListItem from the model
}

<div class="dropdown">
    <form style="display:inline;" method="post" asp-page-handler="Weeks">
        <select asp-for="SelectedWeek" asp-items="@weekSelectList">
            <option value="">Select a Week</option>
        </select>

        <select asp-for="SelectedUser" asp-items="@userSelectList" class="ml-2">
            <option value="">All Users</option>
        </select>

        <button type="submit" class="btn btn-xs btn-success">Filter</button>

        @if (User.IsInRole(Constants.AdminRole) ||
             User.IsInRole(Constants.SuperRole))
        {
            <button type="submit" class="btn btn-xs btn-success" asp-page-handler="ApproveAll">Approve Week</button>
        }
    </form>

    @* Keep the report link outside the form; include both route values *@
    <a asp-page="/Reports/GeneratePdf"
       asp-route-week="@Model.SelectedWeek"
       asp-route-user="@Model.SelectedUser"
       class="btn btn-secondary" role="button">
        Generate Report
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Week Starting</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th>Hours Worked</th>
            <th>Approval Status</th>
        </tr>
    </thead>
    <tbody>

@foreach (var item in Model.TimeEntry)
    {
    <tr>
        <td>
            @{
                // Fix: Use UserManager to get user name by ID
                var user = await UserManager.FindByIdAsync(item.UserID);
                var userName = user != null ? user.UserName : item.UserID;
            }
            @userName
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Week)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TimeIn)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TimeOut)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HoursWorked)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ApprovalStatus)
        </td>
        <td>
            @if ((await AuthorizationService.AuthorizeAsync(
                User, item, TimeEntryOperations.Update)).Succeeded)
                {
                    <a asp-page="./Edit" asp-route-id="@item.TimeEntryId">Edit</a> 
                    <text> | </text>
                }
            
            <a asp-page="./Details" asp-route-id="@item.TimeEntryId">Details</a>
            
            @if ((await AuthorizationService.AuthorizeAsync(
                  User, item, TimeEntryOperations.Delete)).Succeeded)
                {
                    <text> | </text>
                    <a asp-page="./Delete" asp-route-id="@item.TimeEntryId">Delete</a>
                }
        </td>
        <td>
        @if ((await AuthorizationService.AuthorizeAsync(
            User, item, TimeEntryOperations.Approve)).Succeeded)
            {
                @if (item.ApprovalStatus != true)
                {
                        <form style="display:inline;" method="post">
                        <input type="hidden" name="id" value="@item.TimeEntryId" />
                        <input type="hidden" name="status" value="@TimeEntryOperations.Approve" />
                        <button type="submit" class="btn btn-xs btn-success">Approve</button>
                        </form>
                }
                @if (item.ApprovalStatus == true)
                {
                    <form style="display:inline;" method="get">
                        <button class="btn btn-xs btn-success">Report</button>
                    </form>
                }
            }
        </td>
    </tr>
    }
</tbody>
</table>
