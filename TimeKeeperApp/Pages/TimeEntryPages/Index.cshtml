@page
@model TimeKeeperApp.Pages.TimeEntryPages.IndexModel
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Rendering
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole(Constants.InternRole) ||
    User.IsInRole(Constants.AdminRole))
{
    <p>
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    </p>
}

@{
    var weekSelectList = Model.Weeks.Select(w => new SelectListItem
    {
        Value = w.ToString("yyyy-MM-dd"),
        Text = w.ToString("yyyy-MM-dd")
    }).ToList();

    var userSelectList = Model.Users; // already SelectListItem from the model
}

<div class="dropdown">
    <form style="display:inline;" method="get" asp-page-handler="Weeks">
        <select asp-for="SelectedWeek" asp-items="@weekSelectList">
            <option value="">Select a Week</option>
        </select>

        @* Admins and supervisors can filter which user they are viewing; 
           interns can only view their own entries regardless *@
        @if (User.IsInRole(Constants.AdminRole) ||
        User.IsInRole(Constants.SuperRole))
        {
        <select asp-for="SelectedUser" asp-items="@userSelectList" class="ml-2">
            <option value="">All Users</option>
        </select>
        }

        <select asp-for="SelectedApprovalStatus" asp-items="Model.ApprovalStatusOptions" class="ml-2">
            <option value="">Approval Status</option>
        </select>

        <button type="submit" class="btn btn-xs btn-secondary">Filter</button>

        <a asp-page="./Index" class="btn btn-xs btn-secondary ml-2" role="button">Reset</a>
    </form>

    @section Scripts {
        <script>
            function syncFilters() {
                // Get dropdown values
                var week = document.querySelector('[name="SelectedWeek"]').value;
                var userElem = document.querySelector('[name="SelectedUser"]');
                var user = userElem ? userElem.value : '';
                var status = document.querySelector('[name="SelectedApprovalStatus"]').value;

                // Update Approve All hidden fields (if present)
                var weekHidden = document.getElementById('approveAllWeek');
                if (weekHidden) weekHidden.value = week;
                var userHidden = document.getElementById('approveAllUser');
                if (userHidden) userHidden.value = user;
                var statusHidden = document.getElementById('approveAllStatus');
                if (statusHidden) statusHidden.value = status;

                // Update Generate Report link
                var reportBtn = document.getElementById('generateReportBtn');
                if (reportBtn) {
                    var url = '/Reports/GeneratePdf?';
                    if (week) url += 'week=' + encodeURIComponent(week) + '&';
                    if (user) url += 'user=' + encodeURIComponent(user) + '&';
                    if (status) url += 'status=' + encodeURIComponent(status) + '&';
                    url = url.replace(/&$/, '');
                    reportBtn.setAttribute('href', url);
                }
            }

            // Attach to dropdowns
            document.querySelector('[name="SelectedWeek"]').addEventListener('change', syncFilters);
            if (document.querySelector('[name="SelectedUser"]')) {
                document.querySelector('[name="SelectedUser"]').addEventListener('change', syncFilters);
            }
            document.querySelector('[name="SelectedApprovalStatus"]').addEventListener('change', syncFilters);

            // Initialize on page load
            syncFilters();
        </script>
    }
    
    @* Hide the "Approve All" button from interns *@
        @if (User.IsInRole(Constants.AdminRole) ||
             User.IsInRole(Constants.SuperRole))
        {
            <form method="post" asp-page-handler="ApproveAll" style="display:inline;">
                <input type="hidden" id="approveAllWeek" name="SelectedWeek" value="@Model.SelectedWeek" />
                <input type="hidden" id="approveAllUser" name="SelectedUser" value="@Model.SelectedUser" />
                <input type="hidden" id="approveAllStatus" name="SelectedApprovalStatus" value="@Model.SelectedApprovalStatus" />
                <button type="submit" class="btn btn-xs btn-success">Approve All</button>
            </form>
        }

    @* Keep the report link outside the form; include all route values *@
    <a id="generateReportBtn"
       asp-page="/Reports/GeneratePdf"
       asp-route-week="@Model.SelectedWeek"
       asp-route-user="@Model.SelectedUser"
       asp-route-status="@Model.SelectedApprovalStatus"
       class="btn btn-xs btn-primary" role="button">
        Generate Report
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Week Starting</th>
            <th>Time In</th>
            <th>Time Out</th>
            <th>Hours Worked</th>
            <th>Approval Status</th>
            <th>Actions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

@foreach (var item in Model.TimeEntry)
    {
    <tr>
        <td>
            @{
                // Fix: Use UserManager to get user name by ID
                var user = await UserManager.FindByIdAsync(item.UserID);
                var userName = user != null ? user.UserName : item.UserID;
            }
            @userName
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Week)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TimeIn)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TimeOut)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HoursWorked)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ApprovalStatus)
        </td>
        <td>
            @if ((await AuthorizationService.AuthorizeAsync(
                User, item, TimeEntryOperations.Update)).Succeeded)
                {
                    <a asp-page="./Edit" asp-route-id="@item.TimeEntryId">Edit</a> 
                    <text> | </text>
                }
            
            <a asp-page="./Details" asp-route-id="@item.TimeEntryId">Details</a>
            
            @if ((await AuthorizationService.AuthorizeAsync(
                  User, item, TimeEntryOperations.Delete)).Succeeded)
                {
                    <text> | </text>
                    <a asp-page="./Delete" asp-route-id="@item.TimeEntryId">Delete</a>
                }
        </td>
        <td>
        @if ((await AuthorizationService.AuthorizeAsync(
            User, item, TimeEntryOperations.Approve)).Succeeded)
            {
                @if (item.ApprovalStatus != true)
                {
                        <form style="display:inline;" method="post">
                        <input type="hidden" name="id" value="@item.TimeEntryId" />
                        <input type="hidden" name="status" value="@TimeEntryOperations.Approve" />
                        <button type="submit" class="btn btn-xs btn-success">Approve</button>
                        </form>
                }
                @* @if (item.ApprovalStatus == true)
                {
                    <form style="display:inline;" method="get">
                        <button class="btn btn-xs btn-success">Report</button>
                    </form>
                } *@
            }
        </td>
    </tr>
    }
</tbody>
</table>
