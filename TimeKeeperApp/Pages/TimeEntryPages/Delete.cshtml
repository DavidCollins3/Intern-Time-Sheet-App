@page
@model TimeKeeperApp.Pages.TimeEntryPages.DeleteModel
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Delete Time Entry";
}

<div class="row justify-content-center">
    <div class="col-md-4 bg-light rounded shadow mt-5 p-3">
        <h1 class="text-center">@ViewData["Title"]</h1>
    <h3 class="text-center">Are you sure you want to delete this?</h3>
    <hr />
        <dl class="row w-100" style="max-width: 600px;">
        <dt class="col-sm-4">
            @* @Html.DisplayNameFor(model => model.TimeEntry.UserID) *@ User ID
        </dt>
        <dd class="col-sm-8">
            @{
                // Use technique from ./Index.cshtml to get UserName from UserID
                var user = await UserManager.FindByIdAsync(Model.TimeEntry.UserID);
                var userName = user != null ? user.UserName : Model.TimeEntry.UserID;
            }
            @userName
        </dd>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.TimeEntry.Week)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TimeEntry.Week)
        </dd>
        <dt class="col-sm-4">
            @* @Html.DisplayNameFor(model => model.TimeEntry.TimeIn) *@ Time In
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TimeEntry.TimeIn)
        </dd>
        <dt class="col-sm-4">
            @* @Html.DisplayNameFor(model => model.TimeEntry.TimeOut) *@ Time Out
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TimeEntry.TimeOut)
        </dd>
        <dt class="col-sm-4">
            @* @Html.DisplayNameFor(model => model.TimeEntry.HoursWorked) *@ Hours Worked
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TimeEntry.HoursWorked)
        </dd>
        <dt class="col-sm-4">
            @* @Html.DisplayNameFor(model => model.TimeEntry.ApprovalStatus) *@ Approval Status
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.TimeEntry.ApprovalStatus)
        </dd>
    </dl>
    <div class="text-center">
        <form method="post" onsubmit="return confirm('Are you sure you want to delete this Time Entry?');">
            <input type="hidden" asp-for="TimeEntry.TimeEntryId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </form>
    </div>
        <a asp-page="./Index">Back to List</a>
</div>
</div>
