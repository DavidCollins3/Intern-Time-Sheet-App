@page
@model TimeKeeperApp.Pages.TimeEntryPages.DetailsModel
@inject UserManager<IdentityUser> UserManager


@{
    ViewData["Title"] = "Viewing Time Entry";
}

<div class="row justify-content-center">
    <div class="col-md-4 bg-light rounded shadow mt-5 p-3">
        <h1 class="text-center">@ViewData["Title"]</h1>
        <hr />
        <dl class="row w-100" style="max-width: 600px;">
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.UserID) *@ User ID
            </dt>
            <dd class="col-sm-8">
                @{
                    // Use technique from ./Index.cshtml to get UserName from UserID
                    var user = await UserManager.FindByIdAsync(Model.TimeEntry.UserID);
                    var userName = user != null ? user.UserName : Model.TimeEntry.UserID;
                }
                @userName
            </dd>
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.Week) *@ Week Starting
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TimeEntry.Week)
            </dd>
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.TimeIn) *@ Time In
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TimeEntry.TimeIn)
            </dd>
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.TimeOut) *@ Time Out
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TimeEntry.TimeOut)
            </dd>
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.HoursWorked) *@ Hours Worked
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TimeEntry.HoursWorked)
            </dd>
            <dt class="col-sm-4">
                @* @Html.DisplayNameFor(model => model.TimeEntry.ApprovalStatus) *@ Approval Status
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TimeEntry.ApprovalStatus)
            </dd>
        </dl>
        @if (Model.TimeEntry.ApprovalStatus != true)
        {
            @if ((await AuthorizationService.AuthorizeAsync(
                User, Model.TimeEntry, TimeEntryOperations.Approve)).Succeeded)
            {
                <form style="display:inline;" method="post" class="text-center">
                    <input type="hidden" name="id" value="@Model.TimeEntry.TimeEntryId" />
                    <input type="hidden" name="status" value="@TimeEntryOperations.Approve" />
                    <button type="submit" class="w-100 btn btn-xs btn-success">Approve</button>
                </form>
            }
        }
        <div class="text-center mt-3">
            @if ((await AuthorizationService.AuthorizeAsync(
                    User, Model.TimeEntry,
                    TimeEntryOperations.Update)).Succeeded)
            {
                <a asp-page="./Edit" asp-route-id="@Model.TimeEntry.TimeEntryId">Edit</a>
                <text> | </text>
            }
            <a asp-page="./Index">Back to List</a>
        </div>
    </div>
</div>
